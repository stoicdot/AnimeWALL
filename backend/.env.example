# Application
APP_NAME=AnimeWall API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_PREFIX=/api
LOG_LEVEL=INFO

# PostgreSQL (replace the placeholder password; do not commit .env)
DATABASE_URL=postgresql+asyncpg://animewall_app:CHANGE_ME@127.0.0.1:5432/animewall_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5
SQLALCHEMY_ECHO=false

# JSON array. Add the exact origin/port used by your frontend dev server.
CORS_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:5501","http://localhost:5501"]
