# Application
APP_NAME=AnimeWall API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
API_PREFIX=/api
LOG_LEVEL=INFO

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/animewall
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5
SQLALCHEMY_ECHO=false

# JWT Authentication
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Supabase Storage
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=animewall

# Frontend CORS
CORS_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:5501","http://localhost:5501"]